YAS_ENVIRONMENT=development
YAS_DATABASE_URL=sqlite:///./yas.sqlite3
YAS_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
YAS_ACCESS_TOKEN_EXPIRE_MINUTES=480
YAS_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
YAS_MAX_UPLOAD_SIZE_MB=5

# Digital Ocean Spaces (obrigatorio para upload de midia)
YAS_SPACES_REGION=nyc3
YAS_SPACES_BUCKET=yas-embalagens
YAS_SPACES_ACCESS_KEY=
YAS_SPACES_SECRET_KEY=
# Opcional: sobrescreve o endpoint (default: https://<region>.digitaloceanspaces.com)
YAS_SPACES_ENDPOINT_URL=
# Opcional: URL publica do CDN. Default: https://<bucket>.<region>.cdn.digitaloceanspaces.com
YAS_SPACES_CDN_URL=
# Prefixo (pasta virtual) dentro do bucket
YAS_SPACES_KEY_PREFIX=media
